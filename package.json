{
  "name": "money-boys",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "verify": "bash scripts/verify",
    "check-foundry": "bash scripts/check-foundry",
    "check-foundry:node": "node scripts/check-foundry.mjs",
    "engine:typecheck": "pnpm --filter @money-boys/engine typecheck",
    "engine:test": "pnpm --filter @money-boys/engine test",
    "engine:auth": "pnpm --filter @money-boys/engine test:auth",
    "test:e2e": "pnpm --filter @money-boys/desk test:e2e",
    "demo:live": "tsx scripts/demo-dispatcher-lifecycle.ts",
    "demo:rwa": "tsx scripts/demo-rwa-lifecycle.ts",
    "daemon:live": "tsx scripts/run-autonomous-daemon.ts --mode=demo",
    "daemon:paper": "tsx scripts/run-autonomous-daemon.ts --mode=paper"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
